rules_version = '2';

// Todo el acceso a datos pasa por la API (verificación del ID token y
// aislamiento por uid en el backend); ningún cliente lee ni escribe
// Firestore directamente.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
