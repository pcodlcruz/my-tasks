# Entorno de ejecución: local | staging | production. Sin valor, el backend asume
# "production" y se niega a arrancar con las variables de los emuladores (más abajo).
APP_ENV=local
GOOGLE_CLOUD_PROJECT=demo-mytasks
# Solo con APP_ENV=local. Con los emuladores de Auth activos el backend acepta tokens
# sin firmar: nunca deben definirse en staging ni en producción.
FIRESTORE_EMULATOR_HOST=localhost:8080
FIREBASE_AUTH_EMULATOR_HOST=localhost:9099
CORS_ORIGINS=http://localhost:5173
# Correo que se convierte en administrador en su primer inicio de sesión si aún no tiene
# cuenta (feature 003). No es un secreto. En staging y producción lo inyecta el pipeline
# desde la variable BOOTSTRAP_ADMIN_EMAIL del GitHub Environment. Vacío = sin bootstrap.
BOOTSTRAP_ADMIN_EMAIL=
